{
  "name": "rctf",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/admin-bot",
      "apps/api",
      "apps/cli",
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "drizzle-orm": "0.45.2",
      "hono": "4.13.2",
      "mustache": "4.2.0",
      "pino": "10.3.1",
      "postgres": "3.4.9",
      "typescript": "7.0.2",
      "yaml": "2.9.0",
      "zod": "4.4.3"
    }
  },
  "overrides": {
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "bun --ellide-lines=0 run --filter '@rctf/api' --filter '@rctf/web' dev",
    "dev:api": "bun run --filter '@rctf/api' dev",
    "dev:web": "bun run --filter '@rctf/web' dev",
    "dev:seed": "bun run apps/cli/src/index.ts seed",
    "dev:mock": "bun run db:migrate && bun run dev:seed && bun run dev",
    "build": "bun run --filter '*' build",
    "build:api": "bun run --filter '@rctf/api' build",
    "build:web": "bun run --filter '@rctf/web' build",
    "rctf": "bun run apps/cli/src/index.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "bun run format:oxc",
    "format:check": "bun run format:oxc:check",
    "format:oxc": "oxfmt \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte,html,json,jsonc,json5,css,md,mdx}\"",
    "format:oxc:check": "oxfmt --check \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,svelte,html,json,jsonc,json5,css,md,mdx}\"",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter '@rctf/db' generate",
    "db:migrate": "bun run --filter '@rctf/db' migrate",
    "db:pull": "bun run --filter '@rctf/db' pull"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "catalog:"
  }
}
