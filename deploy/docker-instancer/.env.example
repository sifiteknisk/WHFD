DEV_ENV=false

BIND_PORT=1337
WEB_WORKERS=1
USE_PROXY_HEADERS=true

AUTH_TOKEN=changeme!

INSTANCES_HOST=instancer.es3n1n.eu

REDIS_HOST=cache
#REDIS_HOST=127.0.0.1
REDIS_PORT_NUMBER=6379
REDIS_PASSWORD=123

TRAEFIK_PERMANENT_REDIRECT_MIDDLEWARE_NAME=permanent-https-redirect@file
# Instances only count as running once they answer through Traefik. Defaults to
# the Traefik container; set this when the instancer runs outside the compose network.
#TRAEFIK_PROBE_HOST=127.0.0.1

# Instance builds allowed at once per web worker (0 = unlimited). Starts that wait
# longer than START_QUEUE_TIMEOUT_SECONDS for a slot get a "busy, try again" error.
MAX_CONCURRENT_STARTS=5
START_QUEUE_TIMEOUT_SECONDS=10
