DEV_ENV=false

BIND_PORT=1337
WEB_WORKERS=1
USE_PROXY_HEADERS=true

AUTH_TOKEN=changeme!

INSTANCES_HOST=instancer.es3n1n.eu

REDIS_HOST=cache
#REDIS_HOST=127.0.0.1
REDIS_PORT_NUMBER=6379
REDIS_PASSWORD=123

TRAEFIK_PERMANENT_REDIRECT_MIDDLEWARE_NAME=permanent-https-redirect@file
# Instances only count as running once they answer through Traefik. Defaults to
# the Traefik container; set this when the instancer runs outside the compose network.
#TRAEFIK_PROBE_HOST=127.0.0.1

# Start queues the build in Redis and replies "starting" at once. One builder
# process builds MAX_CONCURRENT_STARTS at a time, oldest first. Starts past
# MAX_QUEUED_STARTS waiting jobs get a "server is full" error.
MAX_CONCURRENT_STARTS=10
MAX_QUEUED_STARTS=500

# Refuse starts with a "server is full" error, and pause the builder, while the
# host has less than this much MemAvailable (0 = never refuse).
MIN_AVAILABLE_MEMORY_MB=6144
# Put instance containers in a systemd slice with MemoryMax set, so challenges
# can't starve dockerd, Traefik or the instancer. Create the slice on the host:
#   printf '[Slice]\nMemoryHigh=24G\nMemoryMax=26G\n' > /etc/systemd/system/ti-instances.slice
#   systemctl daemon-reload
#INSTANCE_CGROUP_PARENT=ti-instances.slice
